{
  "name": "sundrowsy-native",
  "version": "1.0.1",
  "description": "SunDrowsy - versao nativa para Windows (app + dot flutuante de status)",
  "main": "main.js",
  "author": "jordanlvs",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "prepare-ota": "node scripts/prepare-ota.js",
    "publish-github": "node -e \"const v=require('./package.json').version;require('child_process').execSync('gh release create v'+v+' dist_github/SunDrowsy-Setup-'+v+'.exe dist_github/SunDrowsy-Setup-'+v+'.exe.blockmap --title v'+v+' --notes \\\"SunDrowsy '+v+'\\\"',{stdio:'inherit'})\"",
    "release": "npm run dist && npm run prepare-ota && npm run publish-github && firebase deploy --only hosting"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.weblv.sundrowsy",
    "productName": "SunDrowsy",
    "asar": true,
    "files": [
      "**/*",
      "!dist*/**",
      "!build/**",
      "!ota-release/**",
      "!scripts/**",
      "!.firebase/**",
      "!.firebaserc",
      "!firebase.json",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/.bin/**",
      "!node_modules/@electron/**",
      "!node_modules/app-builder-bin/**",
      "!node_modules/7zip-bin/**"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "web",
        "filter": [
          "index.html",
          "admin.html",
          "style.css",
          "alert.mp3",
          "assets/**/*",
          "src/**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "perMachine": true,
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "generic",
      "url": "https://sundrowsy-db163.web.app/"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "loudness": "^0.4.2"
  }
}
